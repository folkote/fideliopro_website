# FidelioPro FastAPI Configuration
# Copy this file to .env and replace placeholder values:
#   cp .env.example .env

# Application settings
APP_NAME=FidelioPro FastAPI
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=7080

# DaData API credentials (never commit real values)
DADATA_TOKEN=replace_with_dadata_token
DADATA_SECRET=replace_with_dadata_secret

# Geolocation settings
GEOLOCATION_ENABLED=true
GEOLOCATION_SERVICE_URL=http://ip-api.com/json/{ip}?fields=status,country,city,isp
GEOLOCATION_TIMEOUT=5.0
GEOLOCATION_FALLBACK_SERVICE=https://ipapi.co/{ip}/json/

# PostgreSQL cache settings
CACHE_ENABLED=true
DATABASE_URL=postgresql+psycopg://user:password@db-host:5432/fidelio_address_api
CACHE_SCHEMA=fideliopro_website

# Logging settings
LOG_LEVEL=INFO
LOG_FILE=logs/webserver.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5

# Per-IP rate limiting for paid DaData proxy endpoints
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Static files
STATIC_DIR=static
WEBSITE_DIR=static/website
SQL_DIR=static/sql

# Security
ALLOWED_HOSTS=["*"]
CORS_ORIGINS=["*"]
